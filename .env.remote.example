# Этот файл хранится только на сервере удалённого API.

# Эти же значения инициализируют контейнер PostgreSQL при первом запуске.
# PARSER_DB_HOST — имя сервиса в сети Compose, менять его не нужно.
PARSER_DB_HOST=db
PARSER_DB_PORT=5432
PARSER_DB_NAME=<название базы>
PARSER_DB_USER=<пользователь базы>
PARSER_DB_PASSWORD=<пароль базы>
PARSER_DB_ECHO=false

# Тот же токен указывается в локальном .env разрешённого пользователя.
PARSER_REMOTE_API_TOKEN=<случайный-токен-не-короче-32-символов>
