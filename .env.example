# Эти настройки выдаёт администратор локальному пользователю.
PARSER_REMOTE_API_URL=http://10.0.0.25:8001
PARSER_REMOTE_API_TOKEN=<вставьте-длинный-токен-не-короче-32-символов>
PARSER_REMOTE_API_TIMEOUT=600

PARSER_BROWSER_HOST=127.0.0.1
PARSER_BROWSER_PORT=51112

# Интерфейс скачивается с сервера. Значения по умолчанию подходят всем, менять
# их нужно только при разборе неполадок.
# PARSER_FRONTEND_CACHE_DIR=<каталог кэша интерфейса>
# PARSER_FRONTEND_SYNC_TIMEOUT=15
